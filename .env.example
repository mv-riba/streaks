# Neon base URL: https://<endpoint>.<cell>.<region>.aws.neon.tech/<database>
# (your connection host + database name, over https — no user, password or query string).
# The app derives the Neon Auth URL (.neonauth…/auth) and Data API URL (.apirest…/rest/v1)
# from it. It is public by design: access is controlled by Row Level Security.
EXPO_PUBLIC_NEON_URL=https://ep-YOUR-ENDPOINT.c-3.eu-west-2.aws.neon.tech/neondb

# Optional. Origin that Android/iOS builds send to Neon Auth (native fetch sends none, and
# Better Auth requires a trusted Origin for sign-out and password reset). Must be listed in
# `neon neon-auth domain list`. Defaults to https://streaks.mvriba.com.
# EXPO_PUBLIC_NEON_AUTH_ORIGIN=https://streaks.mvriba.com
